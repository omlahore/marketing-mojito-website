          <script>
  (function(){
    const dock = document.querySelector('.mobile-dock');
    // Delegate clicks for both panel‑toggles and section‑toggles
    dock.addEventListener('click', e => {
      // 1) Top‑level panels (Explore/Solutions/Resources)
      const panelBtn = e.target.closest('.toggle');
      if (panelBtn) {
        e.stopPropagation();
        const panel = document.getElementById(panelBtn.dataset.menu);
        panel.classList.toggle('open');
        // close others
        document.querySelectorAll('.dock-submenu.open').forEach(o => {
          if (o !== panel) o.classList.remove('open');
        });
        return;
      }
      // 2) Nested sections inside Solutions
      const hdr = e.target.closest('.section-header');
      if (hdr) {
        e.stopPropagation();
        const sec = document.getElementById(hdr.dataset.section);
        const nowOpen = sec.classList.toggle('open');
        hdr.classList.toggle('open', nowOpen);
        // close sibling sections
        hdr.closest('ul').querySelectorAll('.section-content').forEach(c => {
          if (c.id !== hdr.dataset.section) {
            c.classList.remove('open');
            c.previousElementSibling.classList.remove('open');
          }
        });
      }
    });
    // click outside closes everything
    document.addEventListener('click', ()=>{
      document.querySelectorAll('.dock-submenu.open').forEach(p=>p.classList.remove('open'));
      document.querySelectorAll('.section-content.open').forEach(c=>{
        c.classList.remove('open');
        c.previousElementSibling.classList.remove('open');
      });
    });
  })();
</script>
