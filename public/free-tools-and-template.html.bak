    ];
    // ► Flatten to create the “All tools” category
    const allTools = baseSections.reduce((acc, sec) => acc.concat(sec.tools), []);
    const sections = [
      { title: 'All tools', tools: allTools },
      ...baseSections
    ];
    // ► Render tabs
    const tabsNav = document.getElementById('tabsNav');
    sections.forEach((sec, i) => {
      const btn = document.createElement('button');
      btn.className = 'tab-button' + (i === 0 ? ' active' : '');
      btn.textContent = sec.title;
      btn.dataset.idx = i;
      tabsNav.appendChild(btn);
    });
    // ► Render section contents
    const sectionsContainer = document.getElementById('sectionsContainer');
    sections.forEach((sec, i) => {
      const wrapper = document.createElement('div');
      wrapper.className = 'section-content' + (i === 0 ? ' active' : '');
      wrapper.id = `section-${i}`;
      wrapper.innerHTML = `
        <h2 class="section-title">${sec.title}</h2>
        <div class="tools-grid"></div>
      `;
      const grid = wrapper.querySelector('.tools-grid');
      sec.tools.forEach((tool, j) => {
        const card = document.createElement('div');
        card.className = 'tool-card';
        card.innerHTML = `
          <h3>${tool.title}</h3>
          <p>${tool.desc}</p>
          <button class="get-tool" data-section="${i}" data-idx="${j}">
            Get this tool
          </button>
        `;
        grid.appendChild(card);
      });
      sectionsContainer.appendChild(wrapper);
    });
    // ► Tab switching
    tabsNav.addEventListener('click', e => {
      if (!e.target.matches('.tab-button')) return;
      const idx = +e.target.dataset.idx;
      document.querySelectorAll('.tab-button').forEach(b => b.classList.remove('active'));
      e.target.classList.add('active');
      document.querySelectorAll('.section-content').forEach((sec, i) => {
        sec.classList.toggle('active', i === idx);
      });
    });
    // ► Modal & form logic
    let selectedTool;
    sectionsContainer.addEventListener('click', e => {
      if (!e.target.matches('.get-tool')) return;
      const s = +e.target.dataset.section;
      const t = +e.target.dataset.idx;
      selectedTool = sections[s].tools[t];
      document.getElementById('leadForm').style.display = 'flex';
      document.getElementById('leadMessage').style.display = 'none';
      document.getElementById('leadBtn').disabled = false;
      document.getElementById('leadModal').style.display = 'flex';
    });
    document.getElementById('closeModal').onclick = () => {
      document.getElementById('leadModal').style.display = 'none';
    };
    document.getElementById('leadBtn').addEventListener('click', async () => {
  const form = document.getElementById('leadForm');
  const btn = document.getElementById('leadBtn');
  const name  = form.name.value.trim();
  const email = form.email.value.trim();
  if (!name || !email) {
    alert('Please fill both your name and email.');
    return;
  }
  // Convert Google Doc → direct PDF
  function toPdf(docUrl) {
    const match = docUrl.match(/\/d\/([^/]+)/);
    if (!match) return docUrl;
    return `https://docs.google.com/document/d/${match[1]}/export?format=pdf`;
  }
  const pdfUrl = toPdf(selectedTool.docUrl);
  form.tool_title.value = selectedTool.title;
  form.tool_link.value = pdfUrl;
  btn.disabled = true;
  btn.textContent = 'Sending...';
  try {
    const res = await fetch('/api/lead-magnet', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        name,
        email,
        pdfName: selectedTool.title,
        pageName: 'Free Tools & Templates',
        tool_link: pdfUrl
      })
    });
    const data = await res.json();
    if (!res.ok || !data.success) {
      throw new Error(data.error || 'Failed to send');
    }
    document.getElementById('leadModal').style.display = 'none';
    window.open(pdfUrl, '_blank');
    form.reset();
  } catch (err) {
    alert('Something went wrong. Please try again.');
    console.error(err);
  } finally {
    btn.disabled = false;
    btn.textContent = 'Send me the tool';
  }
});
  </script>
